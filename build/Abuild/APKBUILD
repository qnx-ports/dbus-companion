pkgname=dbus
pkgver=1.16.2
pkgrel=2
pkgdesc="Freedesktop.org message bus system"
url="https://www.freedesktop.org/Software/dbus"
arch="all"
license="AFL-2.1 OR GPL-2.0-or-later"
#options="!check"
depends="glib qnx-io-sock"
makedepends="
    expat-dev
    glib-dev
    meson
    ninja
    pkgconf
    pkgconf-dev
    qnx-io-sock-dev
    "
pkggroups="messagebus"
install="$pkgname.pre-install $pkgname.post-install"
#triggers="$pkgname.trigger=/usr/share/dbus-1/system.d"
subpackages="
    $pkgname-dev
    $pkgname-doc
    "
source="https://dbus.freedesktop.org/releases/dbus/dbus-$pkgver.tar.xz
        add-freebsd-cred.patch
    "

build() {
    meson setup build \
        -Dprefix=/usr \
        -Dchecks=true \
        -Druntime_dir=/var/run \
        -Dsystem_pid_file=/var/run/dbus/dbus.pid \
        -Dc_link_args=-Wl,-lsocket 
    meson compile -C build
}

check() {
    meson test --print-errorlogs -C build || msg "not all tests pass"
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}


