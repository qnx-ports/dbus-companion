597c69c2c7e4ba48ab9c64af6e314971bcc3f9893f2784113fc384e069a034b639c427f511c7d4a6a2671212ef457bdf0b3e446dc0dab1de5b60e94efa9623df  add-freebsd-cred.patch
"
